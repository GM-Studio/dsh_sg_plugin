{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "specgate-codex",
  "version": "0.3.2",
  "description": "SpecGate 中文项目初始化、技术栈选择、需求澄清与人工审批、独立验证和交付记录。",
  "author": {
    "name": "andy.zx"
  },
  "license": "MIT",
  "repository": "https://github.com/GM-Studio/dsh_sg_plugin",
  "keywords": ["codex", "openspec", "spec-driven", "subagents", "worktree", "quality-gate"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "SpecGate for Codex",
        "shortDescription": "中文表单初始化、需求审批与可验证交付",
        "longDescription": "选择业务项目与技术栈，自动准备 Agent 和 Skill，澄清、反述和评审需求，由用户审批后开始开发；支持本地控制台、独立验证和交付记录。",
        "developerName": "andy.zx",
        "category": "Developer Tools",
        "capabilities": ["Read", "Write"]
      }
    }
  }
}
