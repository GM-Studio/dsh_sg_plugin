{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "specgate-codex",
  "version": "0.3.2",
  "description": "SpecGate 中文项目初始化、技术栈选择、需求澄清与人工审批、独立验证和交付记录。",
  "author": {
    "name": "andy.zx"
  },
  "license": "MIT",
  "repository": "https://github.com/GM-Studio/dsh_sg_plugin",
  "keywords": ["codex", "openspec", "spec-driven", "subagents", "worktree", "quality-gate"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/sg-codex/SKILL.md",
      "interface": {
        "displayName": "SpecGate for Codex",
        "shortDescription": "环境准备、项目准备、需求开发与只读状态",
        "longDescription": "通过统一向导导航至四个任务入口：环境自检与按需安装、项目初始化与接入、受审批的需求开发交付，以及只读项目信息与状态。",
        "developerName": "andy.zx",
        "category": "Developer Tools",
        "capabilities": ["Read", "Write"]
      }
    }
  }
}
