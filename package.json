{
  "name": "specgate-codex",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "SpecGate for Codex: spec-first delivery with native subagents, isolated worktrees and auditable evidence.",
  "keywords": [
    "codex",
    "spec-driven",
    "workflow",
    "gates",
    "openspec",
    "agents"
  ],
  "author": "andy.zx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-Studio/dsh_sg_plugin.git"
  },
  "homepage": "https://github.com/GM-Studio/dsh_sg_plugin",
  "bugs": {
    "url": "https://github.com/GM-Studio/dsh_sg_plugin/issues"
  },
  "files": [
    ".codex-plugin/plugin.json",
    ".agents/plugins/marketplace.json",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "skills",
    "scripts/codex-plugin-smoke.mjs",
    "scripts/codex-source-setup.mjs",
    "scripts/verify-codex-matrix.mjs",
    "src/codex",
    "assets/codex",
    "assets/java-vue/template",
    "docs/quickstart-codex-source.zh.md",
    "docs/verification/codex-sg-v1/crm-native-agent-workflow/README.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codex:mcp": "node src/codex/server.js",
    "codex:smoke": "node scripts/codex-plugin-smoke.mjs",
    "codex:matrix": "node scripts/verify-codex-matrix.mjs",
    "codex:source:setup": "node scripts/codex-source-setup.mjs",
    "test": "node --import ./test/setup-temp.mjs --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
