{
  "name": "dsh-plugin-specgate",
  "version": "4.3.1",
  "private": false,
  "type": "module",
  "description": "SpecGate — spec-driven gated workflow for DeepSeek Harness: project init, gates, skills, OpenSpec state and parallel agents.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "spec-driven",
    "workflow",
    "gates",
    "openspec",
    "agents"
  ],
  "author": "andy.zx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-Studio/dsh_sg_plugin.git"
  },
  "homepage": "https://github.com/GM-Studio/dsh_sg_plugin",
  "bugs": {
    "url": "https://github.com/GM-Studio/dsh_sg_plugin/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    ".codex-plugin/plugin.json",
    ".agents/plugins/marketplace.json",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "skills",
    "scripts/codex-plugin-smoke.mjs",
    "scripts/codex-source-setup.mjs",
    "scripts/verify-codex-matrix.mjs",
    "index.js",
    "src",
    "assets",
    "docs",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codex:mcp": "node src/codex/server.js",
    "codex:smoke": "node scripts/codex-plugin-smoke.mjs",
    "codex:matrix": "node scripts/verify-codex-matrix.mjs",
    "codex:source:setup": "node scripts/codex-source-setup.mjs",
    "test": "node --import ./test/setup-temp.mjs --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "node scripts/quality-gate.mjs --stage=push",
    "gate:fix": "node scripts/quality-format.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:check": "node scripts/install-hooks.mjs --check",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-sh": "0.20.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vue-eslint-parser": "10.3.0"
  }
}
