{
  "name": "specgate-codex",
  "version": "0.3.4",
  "private": false,
  "type": "module",
  "description": "SpecGate Core for Codex：已有 Git 项目的本地需求、测试、实现、验证、Review 与交付闭环。",
  "keywords": [
    "codex",
    "spec-driven",
    "workflow",
    "gates",
    "openspec",
    "agents"
  ],
  "author": "andy.zx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GM-Studio/dsh_sg_plugin.git"
  },
  "homepage": "https://github.com/GM-Studio/dsh_sg_plugin",
  "bugs": {
    "url": "https://github.com/GM-Studio/dsh_sg_plugin/issues"
  },
  "files": [
    ".codex-plugin/plugin.json",
    ".agents/plugins/marketplace.json",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "skills/sg-codex",
    "skills/sg-codex-change",
    "skills/sg-codex-status",
    "skills/sg-codex-project",
    "skills/sg-codex-env",
    "scripts/codex-plugin-smoke.mjs",
    "src/codex",
    "!src/codex/control/**",
    "!src/codex/management/**",
    "!src/codex/channels/**",
    "!src/codex/core/control/**",
    "!src/codex/core/environment-install.js",
    "!src/codex/onboarding.js",
    "!src/codex/init.js",
    "!src/codex/init-consent.js",
    "!src/codex/init-publication.js",
    "!src/codex/init-worker.js",
    "!src/codex/verify.js",
    "assets/codex/agents/specgate_test_designer.toml",
    "assets/codex/agents/specgate_implementer.toml",
    "assets/codex/agents/specgate_reviewer.toml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codex:mcp": "node src/codex/server.js",
    "codex:smoke": "node scripts/codex-plugin-smoke.mjs",
    "codex:matrix": "node scripts/verify-codex-matrix.mjs",
    "codex:source:setup": "node scripts/codex-source-setup.mjs",
    "codex:control": "node scripts/specgate-control.mjs",
    "codex:worker": "node scripts/specgate-worker.mjs",
    "codex:release-check": "node scripts/specgate-release-check.mjs",
    "test": "node scripts/run-tests.mjs core",
    "test:mysql": "node scripts/run-tests.mjs mysql",
    "test:all": "node scripts/run-tests.mjs all",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
